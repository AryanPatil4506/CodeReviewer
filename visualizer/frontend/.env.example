# Leave both unset for local dev (Vite's proxy in vite.config.ts handles
# /api and /ws -> http://localhost:8000) and for the Docker Compose setup
# (nginx.conf proxies them instead). Only set these if the backend is
# served from a different host/port than the frontend.
# VITE_API_BASE_URL=http://localhost:8000
# VITE_WS_BASE_URL=ws://localhost:8000
