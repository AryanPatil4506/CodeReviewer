LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=PASTE_KEY_HERE
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=code-reviewer

GITHUB_TOKEN = PASTE_KEY_HERE

# Determine how many LLM and File calls can be made concurrently based on your system and hardware
LLM_SEMAPHORE = 3
FILE_SEMAPHORE = 5

# Switch this to openai / groq / ollama / openrouter
LLM_PROVIDER=ollama

# Ollama (no API key required)
OLLAMA_CLASSIFIER=qwen2.5-coder
OLLAMA_JUDGE_MODEL=qwen3.5:9b
OLLAMA_SPECIALIST_MODEL=qwen2.5-coder:14b
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:14b

# OpenAI (uncomment if using)
# OPENAI_API_KEY=PASTE_KEY_HERE
# OPENAI_CLASSIFIER=gpt-4o-mini
# OPENAI_JUDGE_MODEL=gpt-4o
# OPENAI_SPECIALIST_MODEL=gpt-4o-mini
# OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Groq (uncomment if using)
# GROQ_API_KEY=PASTE_KEY_HERE
# GROQ_CLASSIFIER=openai/gpt-oss-120b
# GROQ_JUDGE_MODEL=openai/gpt-oss-120b
# GROQ_SPECIALIST_MODEL=openai/gpt-oss-120b
# GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

# Openrouter (uncomment if using)

# IMPORTANT NOTE [READ BEFORE TESTING IF CONCERNED ABOUT PROPRIETARY CODE AND PRIVACY]
# ─────────────────────────────────────────────────────────────
# DATA USAGE NOTICE — FREE-TIER LLM PROVIDERS
# ─────────────────────────────────────────────────────────────
# Context: This is a college project (personal/academic use, not
# production or commercial). Free-tier endpoints are used to keep
# costs at $0 during development of the project.
#
# NVIDIA NIM (free endpoint):
#   - Do NOT send confidential data or personal data (e.g. voices/faces).
#   - Usage is logged for security + product-improvement purposes.
#     Logs are not linked to identity or a persistent identifier.
#   - Governed by NVIDIA API Trial Terms of Service + NVIDIA Privacy Policy.
#     https://assets.ngc.nvidia.com/products/api-catalog/legal/NVIDIA%20API%20Trial%20Terms%20of%20Service.pdf
#     https://www.nvidia.com/en-us/about-nvidia/privacy-policy/
#
# OpenRouter (":free" model variants, e.g. north-mini-code:free, gpt-oss-120b:free):
#   - Free models may use submitted prompts/outputs for training by the
#     underlying provider. Do NOT send proprietary code, API keys, customer
#     data, or anything sensitive through free-tier model IDs.
#   - Paid model IDs on the same OpenRouter key are NOT subject to this —
#     only the ":free" variants.
#
# Disclaimer: Used and developed strictly for project creation and it's personal use/
# testing. No responsibility is taken for any data sent through these
# free-tier endpoints being used as training data by the provider —
# use of free tiers implies acceptance of each provider's own terms
# linked above.
# ─────────────────────────────────────────────────────────────

